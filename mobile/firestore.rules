rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in 
        ['head_of_coaches', 'academic_advisor', 'odip', 'sle'];
    }
    
    function isActiveUser() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    // User requests - anyone can create, only admins can read/update
    match /userRequests/{requestId} {
      allow create: if true; // Anyone can submit a request
      allow read, update, delete: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read/write their own data
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      // Allow reading other users' basic info for community features
      allow read: if isActiveUser();
      
      // Only admins can create/update user accounts
      allow create, update: if isAdmin();
      
      // Only admins can delete/deactivate users
      allow delete: if isAdmin();
    }
    
    // Admin logs - only admins can read
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only server can write logs
    }
    
    // System logs - only admins can read
    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only server can write logs
    }
    
    // Posts collection (for future use)
    match /posts/{postId} {
      allow read: if isActiveUser();
      allow write: if isActiveUser() && isOwner(resource.data.userId);
    }
    
    // Events collection (for future use)
    match /events/{eventId} {
      allow read: if isActiveUser();
      allow write: if isActiveUser() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in 
        ['head_of_coaches', 'academic_advisor', 'odip', 'sle', 'student_leader'];
    }
  }
}
