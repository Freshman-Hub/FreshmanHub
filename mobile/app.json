{
  "expo": {
    "name": "FreshmanHub",
    "slug": "freshmanhub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/freshman-hub-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "fonts": [
      "./src/assets/fonts/Poppins-Regular.ttf",
      "./src/assets/fonts/Poppins-Medium.ttf",
      "./src/assets/fonts/Poppins-SemiBold.ttf",
      "./src/assets/fonts/Poppins-Bold.ttf",
      "./src/assets/fonts/Inter-Regular.ttf",
      "./src/assets/fonts/Inter-SemiBold.ttf"
    ],
    "newArchEnabled": false,
    "updates": {
      "url": "https://u.expo.dev/fe8119e9-464b-46e6-a30d-da1cac954fa5"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ashesi.edu.gh.freshmanhub",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ashesi.edu.gh.freshmanhub",
      "googleServicesFile": "./google-services.json",
      "enableProguardInReleaseBuilds": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/freshman-hub-logo.png"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe8119e9-464b-46e6-a30d-da1cac954fa5"
      }
    }
  }
}
